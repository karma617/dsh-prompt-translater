{
  "name": "@local/dsh-prompt-translater",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Translate newly submitted human prompts to ASCII English once, before conversation admission.",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "index.js",
    "translation.js",
    "default-system-prompt.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "bundle": "tsdown",
    "test": "node --test",
    "check": "node --check index.js && node --check translation.js && node --check default-system-prompt.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  }
}
